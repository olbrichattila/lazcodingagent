        Left = 24
        Top = 220
        Width = 490
        Height = 95
        AutoSize = False
        WordWrap = True
        Caption = 'Older history is summarized automatically using the selected model. This adds API requests. Token sizes are approximate; allow room for model output within your model context window. The current turn stays verbatim. Oversized results stop the run without truncation.'
