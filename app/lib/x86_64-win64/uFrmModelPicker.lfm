object FrmModelPicker: TFrmModelPicker
  Left = 400
  Height = 450
  Top = 200
  Width = 550
  Caption = 'Select Model from Server'
  ClientHeight = 450
  ClientWidth = 550
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnShow = FormShow
  Position = poScreenCenter
  LCLVersion = '2.2.0.0'
  object PnlTop: TPanel
    Left = 0
    Height = 48
    Top = 0
    Width = 550
    Align = alTop
    BevelOuter = bvNone
    ClientHeight = 48
    ClientWidth = 550
    TabOrder = 0
    object LblSearch: TLabel
      Left = 12
      Height = 17
      Top = 15
      Width = 47
      Caption = 'Search:'
      ParentColor = False
    end
    object EdtSearch: TEdit
      Left = 65
      Height = 28
      Top = 10
      Width = 380
      Anchors = [akTop, akLeft, akRight]
      OnChange = EdtSearchChange
      TabOrder = 0
    end
    object BtnRefresh: TButton
      Left = 455
      Height = 28
      Top = 10
      Width = 85
      Anchors = [akTop, akRight]
      Caption = 'Refresh'
      OnClick = BtnRefreshClick
      TabOrder = 1
    end
  end
  object LstModels: TListBox
    Left = 0
    Height = 354
    Top = 48
    Width = 550
    Align = alClient
    ItemHeight = 0
    OnDblClick = LstModelsDblClick
    OnSelectionChange = LstModelsSelectionChange
    TabOrder = 1
  end
  object PnlBottom: TPanel
    Left = 0
    Height = 48
    Top = 402
    Width = 550
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 48
    ClientWidth = 550
    TabOrder = 2
    object LblModelCount: TLabel
      Left = 12
      Height = 17
      Top = 16
      Width = 140
      Caption = 'Showing 0 models'
      Font.Color = clGray
      ParentColor = False
      ParentFont = False
    end
    object BtnSelect: TButton
      Left = 365
      Height = 30
      Top = 9
      Width = 85
      Anchors = [akTop, akRight]
      Caption = 'Select'
      Default = True
      Enabled = False
      OnClick = BtnSelectClick
      TabOrder = 0
    end
    object BtnCancel: TButton
      Left = 455
      Height = 30
      Top = 9
      Width = 85
      Anchors = [akTop, akRight]
      Cancel = True
      Caption = 'Cancel'
      OnClick = BtnCancelClick
      TabOrder = 1
    end
  end
end
