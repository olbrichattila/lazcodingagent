<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="lazaruscodingagent"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="$(ProjOutDir)"/>
        <OtherUnitFiles Value="../src/core;../src/llm;../src/tools;../src/ui;../src/ide"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="$(IDEBuildOptions)"/>
      </Other>
    </CompilerOptions>
    <Description Value="Autonomous Coding Agent for Free Lazarus IDE"/>
    <Version Major="0" Minor="1" Release="0" Build="1"/>
    <Files>
      <Item>
        <Filename Value="../src/core/uAgentTypes.pas"/>
        <UnitName Value="uAgentTypes"/>
      </Item>
      <Item>
        <Filename Value="../src/core/uAgentConfig.pas"/>
        <UnitName Value="uAgentConfig"/>
      </Item>
      <Item>
        <Filename Value="../src/core/uAgentHistory.pas"/>
        <UnitName Value="uAgentHistory"/>
      </Item>
      <Item>
        <Filename Value="../src/core/uAgentCore.pas"/>
        <UnitName Value="uAgentCore"/>
      </Item>
      <Item>
        <Filename Value="../src/core/uAgentThread.pas"/>
        <UnitName Value="uAgentThread"/>
      </Item>
      <Item>
        <Filename Value="../src/llm/uLLMClient.pas"/>
        <UnitName Value="uLLMClient"/>
      </Item>
      <Item>
        <Filename Value="../src/llm/uWindowsHTTP.pas"/>
        <UnitName Value="uWindowsHTTP"/>
      </Item>
      <Item>
        <Filename Value="../src/tools/uToolBase.pas"/>
        <UnitName Value="uToolBase"/>
      </Item>
      <Item>
        <Filename Value="../src/tools/uToolFileOps.pas"/>
        <UnitName Value="uToolFileOps"/>
      </Item>
      <Item>
        <Filename Value="../src/ui/uFrmSettings.pas"/>
        <UnitName Value="uFrmSettings"/>
      </Item>
      <Item>
        <Filename Value="../src/ui/uFrmModelPicker.pas"/>
        <UnitName Value="uFrmModelPicker"/>
      </Item>
      <Item>
        <Filename Value="../src/ui/uFrmChat.pas"/>
        <UnitName Value="uFrmChat"/>
      </Item>
      <Item>
        <Filename Value="../src/ui/uFrmChatSession.pas"/>
        <UnitName Value="uFrmChatSession"/>
      </Item>
      <Item>
        <Filename Value="../src/ui/uFrmPlanResult.pas"/>
        <UnitName Value="uFrmPlanResult"/>
      </Item>
      <Item>
        <Filename Value="../src/ui/uMarkdownView.pas"/>
        <UnitName Value="uMarkdownView"/>
      </Item>
      <Item>
        <Filename Value="../src/ide/uAgentPlugin.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uAgentPlugin"/>
      </Item>
      <Item>
        <Filename Value="../src/tools/uToolPaths.pas"/>
        <UnitName Value="uToolPaths"/>
      </Item>
      <Item>
        <Filename Value="../src/tools/uToolProcess.pas"/>
        <UnitName Value="uToolProcess"/>
      </Item>
      <Item>
        <Filename Value="../src/tools/uToolPatch.pas"/>
        <UnitName Value="uToolPatch"/>
      </Item>
      <Item>
        <Filename Value="../src/tools/uToolLocal.pas"/>
        <UnitName Value="uToolLocal"/>
      </Item>
      <Item>
        <Filename Value="../src/llm/uLLMAdapter.pas"/>
        <UnitName Value="uLLMAdapter"/>
      </Item>
      <Item>
        <Filename Value="../src/llm/uAgentContext.pas"/>
        <UnitName Value="uAgentContext"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="CodeTools"/>
      </Item>
      <Item>
        <PackageName Value="IDEIntf"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
      <Item>
        <PackageName Value="TurboPowerIPro"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
